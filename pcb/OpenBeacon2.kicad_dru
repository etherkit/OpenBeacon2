(version 1)
# House rules carried over from Si5351AVFO (NT7S/Si5351AVFO pcb-layout).
# USB-C receptacle (J12): GND pads sit ~0.18 mm from the locating NPTHs by footprint design
(rule "J12 footprint-internal hole clearance"
  (condition "A.memberOfFootprint('J12') && B.memberOfFootprint('J12')")
  (constraint hole_clearance (min 0.15mm)))
(rule "J12 shield solid"
  (condition "A.memberOfFootprint('J12') && A.Pad_Type == 'Through-hole'")
  (constraint zone_connection solid))
# CPWG: 0.20 mm gap from every RF50 track/pad to the coplanar GND pour (JLC calc: 0.31/0.20 = 50 ohm on L1 over L2)
(rule "RF50 CPWG gap to GND pour"
  (condition "A.NetClass == 'RF50' && B.Type == 'Zone' && B.Net == 'GND'")
  (constraint clearance (min 0.2mm)))
# Edge-launch / edge-mount connectors sit on the board edge by design
(rule "edge connectors"
  (condition "A.memberOfFootprint('J6') || A.memberOfFootprint('J16') || A.memberOfFootprint('J11') || A.memberOfFootprint('J12')")
  (constraint edge_clearance (min 0mm)))
