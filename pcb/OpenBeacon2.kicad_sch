	(label "SI_CLKIN"
		(at 76.2 220.98 0)
		(fields_autoplaced yes)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "38cab154-5979-4c07-8d3b-5a7539953045")
	)
	(text "J16 CLKIN (Si5351-B DS rev 1.3 Table 6, Table 16): 10-100 MHz, VIL < 0.3 VDD, VIH > 0.7 VDD, max 3.6 V; input not pulled internally.\nR43 terminates 50 ohm; C54 AC-couples; R44/R45 bias CLKIN at VDD/2. Sine needs >= 1.32 Vpp (+6.4 dBm) and <= 3.9 Vpp (+15.8 dBm).\nXB open (TCXO on XA, DS 6.6). OEB tied low = outputs enabled. INTR open drain, R46 10k (> 4.7k, DS Table 16) -> SI_INTR (PB3).\nCLK0 -> U3 PA buffer, CLK2 -> J6 SMA, CLK4 -> R47 33R -> CAL_CLK (PB2, EVSYS CH0/1) for the 10 s PPS gate count.\nC14 VDD, C50-C53 VDDOA-D: one 100n per supply pin, at the pins (DS 7.1). EP (pin 21) = GND."
		(exclude_from_sim no)
		(at 15.24 237.49 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left top)
		)
		(uuid "d9dbf99f-b81a-406a-9773-c9cddf266bb1")
	)
