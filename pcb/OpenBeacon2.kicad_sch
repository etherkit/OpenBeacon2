	)
	(text "U5 MCP4725 12-bit DAC on\nSCL_5V / SDA_5V (A0 = GND).\nVOUT -> R7 56R -> PA gates.\nC9 1u on VOUT, C10 100n VDD.\nJ1: bias voltage test point."
		(exclude_from_sim no)
		(at 15.24 146.05 0)
		(effects
			(font
				(size 1.0 1.0)
			)
