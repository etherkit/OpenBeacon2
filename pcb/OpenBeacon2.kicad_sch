	)
	(text "TX (MCU PA4) drives Q1\n2N7002; R1 22k pull-down\nholds it off at reset.\nQ1 pulls the Q2 AO3407A\ngate low via R3 22k: P-FET\nhigh-side switch for the\n12 V PA supply. R2 22k G-S\npull-up, C4 10n D-G slows\nthe edges.\nR6 ferrite + C7 1u filter.\nR8 0.2R 1% PA current shunt;\nU14 senses it (TP1/TP2)."
		(exclude_from_sim no)
		(at 15.24 55.88 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left top)
		)
		(uuid "f9baccb8-d997-4238-b442-764f17f31bb0")
	)
	(rectangle
		(start 13.97 104.14)
		(end 125.73 139.7)
