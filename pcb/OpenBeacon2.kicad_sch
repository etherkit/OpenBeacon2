			(color 0 0 200 1)
		)
		(fill
			(type none)
		)
		(uuid "309ce5ba-b410-480f-8070-ffe61519de3c")
	)
	(text "Power amplifier"
		(exclude_from_sim no)
		(at 15.24 106.68 0)
		(effects
			(font
				(size 1.6 1.6)
				(thickness 0.32)
				(bold yes)
				(color 0 0 200 1)
			)
			(justify left)
		)
		(uuid "907f6c64-7fe6-4ab8-b1f1-8e4d18f207d5")
	)
	(text "CLK0 (Si5351C) -> U3\nSN74LVC1G17 buffer\n-> C5 100n -> Q3/Q8\nBS170 in parallel (DNP,\nhand-solder), R16/R17\n10R gate stoppers.\nDrain fed from J3 via L2.\nR5 3.3k + C8 100n:\ndrain to buffer-out RC.\nC11 100n DC block\nto LPF_IN."
		(exclude_from_sim no)
		(at 15.24 109.22 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left top)
		)
		(uuid "7761e45f-c106-464c-993c-8d5dfe6bd464")
	)
