	(text "F2-F5 low-pass filters (T30 toroids)" (exclude_from_sim no) (at 13.97 22.86 0) (effects (font (size 1.6 1.6) (thickness 0.32) (bold yes) (color 0 120 120 1)) (justify left)) (uuid "b2cad0ac-c93a-45a7-a399-d88d1f0130db"))
	(text "Four 7th-order Cauer LPFs, hand-wound T30 toroids.\nSchematic + winding table on sheet LPF Filters.\nDesigned for 1 W output max." (exclude_from_sim no) (at 15.24 127 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b82f6a42-2a52-45f4-8367-2804f9046d61"))
