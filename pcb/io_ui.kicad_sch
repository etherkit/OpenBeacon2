			)
			(justify left)
		)
		(uuid "8de4ff3f-428c-4c95-a20e-8a40afa12fce")
	)
	(text "Same module and pinout as Si5351AVFO DS1: DNP, kit-supplied,\nuser-soldered. 3.3 V logic, no level shift.\nFB1 + C25-C27 copy the VFO OLED rail filter at the header.\nSPI1 ALT1: SCK PC6, MOSI PC4; CS PC7, DC PB4, RES PB5."
		(exclude_from_sim no)
		(at 15.24 90.17 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left top)
		)
		(uuid "d43a3b3a-737e-4664-a6b4-038e8bd855d7")
	)
