	)
	(text "Function keys S1 / S2 / S6 in one row directly under DS1\n(as on Si5351AVFO). D-pad cross: S5 Up, S4 Down,\nS3 Left, S7 Right. Each line: 10k pull-up, 10k series,\n100n at the MCU pin (Si5351AVFO network).\nAll switches Kinghelm KH-6X6X13H-STM, pressed = low."
		(exclude_from_sim no)
		(at 147.32 20.32 0)
		(effects
			(font
				(size 1.0 1.0)
			)
