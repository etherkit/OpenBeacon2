	(text "J8: I2C bus (3.3 V, SDA/SCL pull-ups R14/R15 3.3k).\nJ10: UART on USART1 (PC0/PC1).\nESD: D19/D20 SP0503BAHT at the header pins,\nR76-R79 220R in series toward the MCU."
		(exclude_from_sim no)
		(at 52.07 19.05 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left top)
		)
		(uuid "d2a6f751-bd01-40f4-aa1d-e7df6bdf299f")
	)
