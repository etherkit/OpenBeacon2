		(uuid "6d06388d-3a61-4240-a1e0-8625e51b5cee")
	)
	(text "128x64 OLED (1.3in SH1106, SPI)"
		(exclude_from_sim no)
		(at 15.24 62.87 0)
		(effects
			(font
				(size 1.6 1.6)
				(thickness 0.32)
