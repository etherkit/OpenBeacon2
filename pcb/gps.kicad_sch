		(uuid "36447ab3-14ee-4d49-82f7-e4b419f0211f")
	)
	(text "[x] Antenna short: TPS22941 limit 40-80 mA,\n     auto-restart, avg <= 27 mA (was 320 mA).\n[x] V_BCKP: CR1220 in KH-BS1220-2-SMT\n     (C5365932); C47/D13/R41 removed.\n[ ] BT1 footprint: draw from KH-BS1220-2-SMT DS.\n[ ] U13 TPS22941 JLC stock thin (26 pcs).\n[ ] Short peak 80 mA > VCC_RF 50 mA op. (DS T13)\n     for <= 20 ms bursts; confirm on bench.\n[ ] V_IO ramp 25-35000 us/V (DS 4.1): measure.\n[ ] GPS_PPS MCU pin: see mcu_usb."
		(exclude_from_sim no)
		(at 199.39 81.28 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left top)
		)
